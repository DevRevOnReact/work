# Local development: no browser login or access key is needed.
POSTGRES_PASSWORD=
APP_ORIGIN=
AUTH_REQUIRED=false
EMBEDDED_SEARCHES=true
AUTOMATIC_SEARCH_SCHEDULE=true
SEARCH_TIMEZONE=Europe/Moscow

# Optional search notifications.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
RESEND_API_KEY=
NOTIFICATION_EMAIL=
NOTIFICATION_FROM=JobPilot <onboarding@resend.dev>
NOTIFICATION_MIN_SCORE=0
PUBLIC_APP_URL=

# Cloud hosting. Keep false for native local development.
HOSTED_MODE=false
STORE_RESUME_FILES_IN_DB=false
DATABASE_URL_UNPOOLED=
LOGIN_USER=jobpilot
LOGIN_PASSWORD=

# Optional legacy integrations.
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=
LLM_QUESTION_LIMIT=6
BROWSER_TIMEOUT_MS=30000
APPLICATION_BROWSER_HEADLESS=false
APPLICATION_TIMEOUT_SECONDS=600
APPLICATION_SESSION_SECONDS=900
APPLICATION_SESSION_LIMIT=3
APPLICATION_IDLE_POLL_SECONDS=30

# Optional server-to-server authentication when explicitly enabled.
API_TOKEN=
